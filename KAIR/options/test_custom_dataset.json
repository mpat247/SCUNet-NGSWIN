{
  "task": "scunet_ngswin_custom_dataset",
  "model": "scunet_ngswin",
  "gpu_ids": [0],
  "dist": false,

  "scale": 1,
  "n_channels": 1,

  "path": {
    "root": "training_results/custom_dataset",
    "pretrained_netG": "training_results/conv_nstb/models/100000_G.pth",
    "pretrained_netE": null
  },

  "datasets": {
    "train": {
      "name": "custom_train",
      "dataset_type": "custom",
      "dataroot_H": "/path/to/your/custom/dataset/train",
      "input_format": "png",
      "gt_format": "png",
      "input_key": "input",
      "gt_key": "gt",
      "dataloader_shuffle": true,
      "dataloader_num_workers": 8,
      "dataloader_batch_size": 4
    },
    "test": {
      "name": "custom_test",
      "dataset_type": "custom",
      "dataroot_H": "/path/to/your/custom/dataset/test",
      "input_format": "png",
      "gt_format": "png",
      "input_key": "input",
      "gt_key": "gt"
    }
  },

  "netG": {
    "net_type": "scunet_ngswin",
    "in_nc": 1,
    "out_nc": 1,
    "config": [1, 1, 1, 1, 1, 1, 1],
    "dim": 32,
    "drop_path_rate": 0.0,
    "input_resolution": 512,
    "block_variant": "conv_nstb",

    "init_type": "kaiming_normal",
    "init_bn_type": "constant",
    "init_gain": 1.0
  },

  "train": {
    "G_lossfn_type": "l1",
    "G_lossfn_weight": 1.0,
    "E_decay": 0.999,

    "G_optimizer_type": "adam",
    "G_optimizer_lr": 1e-4,
    "G_optimizer_wd": 0,

    "G_scheduler_type": "MultiStepLR",
    "G_scheduler_milestones": [200000, 400000, 600000, 800000],
    "G_scheduler_gamma": 0.5,

    "G_param_strict": true,
    "E_param_strict": true,

    "checkpoint_test": 20000,
    "checkpoint_save": 10000,
    "checkpoint_print": 1000,
    "use_fp16": true
  }
}
